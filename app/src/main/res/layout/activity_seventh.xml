<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SeventhActivity"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="UselessParent,SpeakableTextPresentCheck">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Most Famous Places in Amritsar"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="#000"
                android:textSize="22sp"
                android:layout_marginTop="8dp"/>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="219dp"
                android:layout_margin="10dp"
                android:baselineAligned="false"
                android:id="@+id/img10"
                android:src="@drawable/durgaini" />

            <Button
                android:id="@+id/button1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_margin="10dp"
                android:textColor="#FFF"
                android:backgroundTint="#E91E63"
                android:text="durgaina"
                android:textSize="25sp"
                android:textStyle="bold" />


            <ImageView
                android:layout_width="match_parent"
                android:layout_height="219dp"
                android:layout_margin="10dp"
                android:src="@drawable/gurudwara" />

            <Button
                android:id="@+id/button2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_margin="10dp"
                android:text="Gurudwara"
                android:backgroundTint="#E91E63"
                android:textColor="#FFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="219dp"
                android:layout_margin="10dp"
                android:src="@drawable/jallain" />

            <Button
                android:id="@+id/button3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_margin="10dp"
                android:text="Jallainwallabagh"
                android:backgroundTint="#E91E63"
                android:textColor="#FFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="219dp"
                android:layout_margin="10dp"
                android:src="@drawable/museum" />

            <Button
                android:id="@+id/button4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#E91E63"
                android:layout_gravity="center_horizontal"
                android:layout_margin="10dp"
                android:text="Partitionmuseum"
                android:textColor="#FFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="219dp"
                android:layout_margin="10dp"
                android:src="@drawable/mahatalli" />

            <Button
                android:id="@+id/button5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#E91E63"
                android:layout_gravity="center_horizontal"
                android:layout_margin="10dp"
                android:text="Akattakat"
                android:textColor="#FFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="219dp"
                android:layout_margin="10dp"
                android:src="@drawable/ram" />

            <Button
                android:id="@+id/button6"
                android:layout_width="match_parent"
                android:backgroundTint="#E91E63"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_margin="10dp"
                android:text="Ramtirath"
                android:textColor="#FFF"
                android:textSize="25sp"
                android:textStyle="bold" />
        </LinearLayout>

    </ScrollView>

</LinearLayout>